# Public API URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:5175/api

# Use the same Google OAuth client ID configured in backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional server-side API URL. Docker Compose supplies this automatically.
# Set it when running Next.js somewhere that cannot reach NEXT_PUBLIC_API_URL.
# BACKEND_API_URL=http://backend:5175/api
