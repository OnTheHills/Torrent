# Express API
PORT=5175

# Use this URI when running the full Docker Compose stack.
MONGO_URI=mongodb://mongo:27017/Torrent

# Google OAuth must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Generate a long, random value for signing login sessions.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# true fetches live procurement data before the API begins serving requests.
# false skips the startup fetch; the daily 02:00 Asia/Bangkok sync still runs.
FETCH_ON_STARTUP=false
